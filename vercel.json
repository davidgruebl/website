{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(www\\.)?dtg\\.sexy" }],
      "destination": "https://davidgruebl.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www\\.davidgruebl\\.com" }],
      "destination": "https://davidgruebl.com/$1",
      "permanent": true
    }
  ]
}
